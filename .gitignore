# Broken or archived local Git metadata
.git.broken-*/

# Local runtime state and generated reports
.openclaw/
.progress_report_log.json
.fallback_alert_log.json
.monitoring_lifecycle/
.stage_report_outbox/
.manual_audit_runs/
.manual_worker_runs/

# Local learnings and scratch artifacts
.learnings/

# Deep research run outputs and generated sync reports
deep-research/runs/
deep-research/reports/

# RAGFlow sync state. These manifests record the absolute path of every synced
# source file, so they carry the operator's local directory layout and the
# titles of internal reference documents. tests/test-contracts.sh already skips
# state/ in its personal-path scan; this keeps the same files out of git.
ragflow_local_kb/state/

# Pre-relocation duplicates left in the working tree. The tracked copies are
# docs/assets/ and deep-research/config/; these two roots are stale twins.
/assets/
/config/

# Third-party skill package installed into the workspace, not part of this
# project's source.
skills/ima-skills/

# Local/private RAGFlow configuration
deep-research/config/*.env
deep-research/config/*profiles.json
deep-research/config/ragflow_folder_mappings.json
deep-research/config/install.summary.local.json
!deep-research/config/*.example.env
!deep-research/config/*profiles.example.json
!deep-research/config/ragflow_folder_mappings.example.json

# OS/editor noise
.DS_Store
*.swp
*.tmp
*.bak-*

# Logs and pid files
*.log
*.pid
