# Copy to runtime.local.env for a machine that should keep local runtime wiring.
# Do not commit runtime.local.env.

# Where final accepted research runs are synced for local Obsidian use.
export OBSIDIAN_VAULT="${OBSIDIAN_VAULT:-$HOME/.openclaw/deep-research-vault}"

# The live workspace that is allowed to auto-load runtime.local.env.
export OPENCLAW_LIVE_WORKSPACE="${OPENCLAW_LIVE_WORKSPACE:-$HOME/.openclaw/workspace-deep-research-master}"

# Optional local Feishu/Lark delivery wiring.
# Production cron lifecycle uses the OpenClaw CLI/SQLite backend. The JSON path
# may still provide delivery metadata; it is not scheduling truth.
export OPENCLAW_CRON_BACKEND="${OPENCLAW_CRON_BACKEND:-openclaw-cli}"
export OPENCLAW_CRON_JOBS_JSON="${OPENCLAW_CRON_JOBS_JSON:-$HOME/.openclaw/cron/jobs.json}"
export OPENCLAW_NODE_BIN="${OPENCLAW_NODE_BIN:-/opt/homebrew/bin/node}"
export OPENCLAW_BIN="${OPENCLAW_BIN:-/opt/homebrew/bin/openclaw}"
# Optional reference used only to prevent production CLI mutations from a
# non-live workspace. Set it when the system CLI is installed elsewhere.
export OPENCLAW_SYSTEM_BIN="${OPENCLAW_SYSTEM_BIN:-$OPENCLAW_BIN}"
export OPENCLAW_LARK_WRAPPER="${OPENCLAW_LARK_WRAPPER:-$HOME/.openclaw/workspace/scripts/lark-cli-openclaw.sh}"
export OPENCLAW_FEISHU_ACCOUNT_ID="${OPENCLAW_FEISHU_ACCOUNT_ID:-deep-research-master}"

# Optional explicit stage-report target. If empty, emit-stage-report.sh resolves
# the user from OPENCLAW_CRON_JOBS_JSON.
# export OPENCLAW_STAGE_REPORT_FEISHU_USER_ID=""

# Search backend keys. Keep real values in runtime.local.env or the OpenClaw
# secret environment, never in tracked files.
# export ANYSEARCH_API_KEY=""
# export TAVILY_API_KEY=""

# Model routing notes for operators and weaker-model deployments.
# The validated baseline used moonshot/kimi-k2.6 with stronger fallbacks. If your
# cloud OpenClaw runtime uses qwen/qwen3.6 or another weaker model, keep the
# setup wizard output and docs/INSTALLATION.md visible during setup.
# export DEEP_RESEARCH_PRIMARY_MODEL="moonshot/kimi-k2.6"
# export DEEP_RESEARCH_MODEL_FALLBACKS="openai/gpt-5.5,local-summary/qwen3.5-9b-q8"
